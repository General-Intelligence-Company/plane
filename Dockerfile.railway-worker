# Railway Dockerfile for Plane Worker (Celery background worker)
# Build context: repository root

FROM python:3.12.10-alpine AS builder

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Update system packages for security
RUN apk update && apk upgrade

WORKDIR /code

# Install build dependencies
RUN apk add --no-cache --upgrade \
    "libpq" \
    "libxslt" \
    "xmlsec" \
    "ca-certificates" \
    "openssl"

# Copy requirements first for better caching
COPY apps/api/requirements.txt ./
COPY apps/api/requirements ./requirements

RUN apk add --no-cache libffi-dev
RUN apk add --no-cache --virtual .build-deps \
    "bash~=5.2" \
    "g++" \
    "gcc" \
    "cargo" \
    "git" \
    "make" \
    "postgresql-dev" \
    "libc-dev" \
    "linux-headers" \
    && \
    pip install -r requirements.txt --compile --no-cache-dir \
    && \
    apk del .build-deps \
    && \
    rm -rf /var/cache/apk/*

# Production stage
FROM python:3.12.10-alpine AS production

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install runtime dependencies
RUN apk update && apk upgrade && \
    apk add --no-cache \
    "libpq" \
    "libxslt" \
    "xmlsec" \
    "ca-certificates" \
    "openssl" \
    "bash~=5.2" \
    && rm -rf /var/cache/apk/*

WORKDIR /code

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages/ /usr/local/lib/python3.12/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/

# Copy application code
COPY apps/api/manage.py manage.py
COPY apps/api/plane plane/
COPY apps/api/templates templates/
COPY apps/api/package.json package.json
COPY apps/api/bin ./bin/

# Create logs directory and set permissions
RUN mkdir -p /code/plane/logs && \
    chmod +x ./bin/* && \
    chmod -R 777 /code

# Worker doesn't expose a port, but we keep it for consistency
# Railway may still assign a PORT env var

# Health check for Celery worker - check if the process is running
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD celery -A plane inspect ping -d celery@$HOSTNAME || exit 1

# Command - Celery worker
CMD ["./bin/docker-entrypoint-worker.sh"]
