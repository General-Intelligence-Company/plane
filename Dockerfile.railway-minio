# Railway Dockerfile for Plane MinIO (S3-compatible storage)
# This runs a MinIO server for S3-compatible object storage
# For production, consider using Railway's managed storage or external S3

FROM minio/minio:latest

# Railway uses PORT env var - MinIO needs specific ports
# API port: 9000 (default)
# Console port: 9090

# Environment variables for MinIO
# These should be set in Railway's environment variables:
# - MINIO_ROOT_USER (required)
# - MINIO_ROOT_PASSWORD (required)

# Create data directory
# Note: Railway manages volumes externally, VOLUME instruction not allowed
RUN mkdir -p /data

# Expose ports
EXPOSE 9000 9090

# Health check for MinIO
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:9000/minio/health/live || exit 1

# Start MinIO server
# Railway sets PORT env var, but MinIO uses specific ports
# The console is available at :9090
CMD ["server", "/data", "--console-address", ":9090"]
