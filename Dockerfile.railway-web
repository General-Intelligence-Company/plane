# Railway Dockerfile for Plane Web Frontend (React/Vite app)
# Build context: repository root

FROM node:22-alpine AS base

# Setup pnpm package manager with corepack and configure global bin directory for caching
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# *****************************************************************************
# STAGE 1: Build the project
# *****************************************************************************
FROM base AS builder
RUN apk add --no-cache libc6-compat
# Set working directory
WORKDIR /app

ARG TURBO_VERSION=2.6.3
RUN corepack enable pnpm && pnpm add -g turbo@${TURBO_VERSION}
COPY . .

RUN turbo prune --scope=web --docker

# *****************************************************************************
# STAGE 2: Install dependencies & build the project
# *****************************************************************************
# Add lockfile and package.json's of isolated subworkspace
FROM base AS installer

RUN apk add --no-cache libc6-compat
WORKDIR /app

# First install the dependencies (as they change less often)
COPY .gitignore .gitignore
COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN corepack enable pnpm

# Copy full directory structure before fetch to ensure all package.json files are available
COPY --from=builder /app/out/full/ .
COPY turbo.json turbo.json

# Install dependencies (Railway doesn't support cache mounts)
RUN pnpm install --frozen-lockfile

# Railway injects these as environment variables at build time
# For PR environments, URLs are computed from Railway service variables
ARG VITE_API_BASE_URL=""
ARG VITE_ADMIN_BASE_URL=""
ARG VITE_ADMIN_BASE_PATH="/god-mode"
ARG VITE_LIVE_BASE_URL=""
ARG VITE_LIVE_BASE_PATH="/live"
ARG VITE_SPACE_BASE_URL=""
ARG VITE_SPACE_BASE_PATH="/spaces"
ARG VITE_WEB_BASE_URL=""

# Railway PR environment detection variables
ARG RAILWAY_ENVIRONMENT_NAME=""
ARG RAILWAY_SERVICE_PLANE_API_V2_URL=""
ARG RAILWAY_SERVICE_PLANE_WEB_V2_URL=""

ENV VITE_ADMIN_BASE_PATH=$VITE_ADMIN_BASE_PATH
ENV VITE_LIVE_BASE_PATH=$VITE_LIVE_BASE_PATH
ENV VITE_SPACE_BASE_PATH=$VITE_SPACE_BASE_PATH
ENV NEXT_TELEMETRY_DISABLED=1
ENV TURBO_TELEMETRY_DISABLED=1

# Build script that computes URLs for PR environments
# If RAILWAY_ENVIRONMENT_NAME contains "pr-" and service URLs are available,
# use them instead of the provided base URLs
RUN set -e; \
    FINAL_API_URL="$VITE_API_BASE_URL"; \
    FINAL_WEB_URL="$VITE_WEB_BASE_URL"; \
    FINAL_ADMIN_URL="$VITE_ADMIN_BASE_URL"; \
    FINAL_LIVE_URL="$VITE_LIVE_BASE_URL"; \
    FINAL_SPACE_URL="$VITE_SPACE_BASE_URL"; \
    \
    if echo "$RAILWAY_ENVIRONMENT_NAME" | grep -q "pr-"; then \
      echo "PR environment detected: $RAILWAY_ENVIRONMENT_NAME"; \
      if [ -n "$RAILWAY_SERVICE_PLANE_API_V2_URL" ]; then \
        FINAL_API_URL="https://${RAILWAY_SERVICE_PLANE_API_V2_URL}"; \
        echo "Using PR API URL: $FINAL_API_URL"; \
      fi; \
      if [ -n "$RAILWAY_SERVICE_PLANE_WEB_V2_URL" ]; then \
        FINAL_WEB_URL="https://${RAILWAY_SERVICE_PLANE_WEB_V2_URL}"; \
        FINAL_ADMIN_URL="https://${RAILWAY_SERVICE_PLANE_WEB_V2_URL}"; \
        FINAL_LIVE_URL="https://${RAILWAY_SERVICE_PLANE_WEB_V2_URL}"; \
        FINAL_SPACE_URL="https://${RAILWAY_SERVICE_PLANE_WEB_V2_URL}"; \
        echo "Using PR Web URL: $FINAL_WEB_URL"; \
      fi; \
    else \
      echo "Production/staging environment: $RAILWAY_ENVIRONMENT_NAME"; \
    fi; \
    \
    export VITE_API_BASE_URL="$FINAL_API_URL"; \
    export VITE_WEB_BASE_URL="$FINAL_WEB_URL"; \
    export VITE_ADMIN_BASE_URL="$FINAL_ADMIN_URL"; \
    export VITE_LIVE_BASE_URL="$FINAL_LIVE_URL"; \
    export VITE_SPACE_BASE_URL="$FINAL_SPACE_URL"; \
    \
    echo "Final build config:"; \
    echo "  VITE_API_BASE_URL=$VITE_API_BASE_URL"; \
    echo "  VITE_WEB_BASE_URL=$VITE_WEB_BASE_URL"; \
    \
    pnpm turbo run build --filter=web

# *****************************************************************************
# STAGE 3: Serve with nginx (production)
# *****************************************************************************
FROM nginx:1.27-alpine AS production

# Install curl for health checks
RUN apk add --no-cache curl

COPY apps/web/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=installer /app/apps/web/build/client /usr/share/nginx/html

# Railway uses PORT env var - update nginx config to use it
# We create an entrypoint script to handle dynamic port
RUN echo '#!/bin/sh' > /docker-entrypoint.sh && \
    echo 'sed -i "s/listen 3000;/listen ${PORT:-3000};/g" /etc/nginx/nginx.conf' >> /docker-entrypoint.sh && \
    echo 'exec nginx -g "daemon off;"' >> /docker-entrypoint.sh && \
    chmod +x /docker-entrypoint.sh

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:${PORT:-3000}/ >/dev/null || exit 1

CMD ["/docker-entrypoint.sh"]
