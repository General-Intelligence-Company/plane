# Railway Dockerfile for Plane API (Django REST API server)
# Build context: repository root (use --build-context or copy strategy)

FROM python:3.12.10-alpine AS builder

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Update system packages for security
RUN apk update && apk upgrade

WORKDIR /code

# Install build dependencies
RUN apk add --no-cache --upgrade \
    "libpq" \
    "libxslt" \
    "xmlsec" \
    "ca-certificates" \
    "openssl"

# Copy requirements first for better caching
COPY apps/api/requirements.txt ./
COPY apps/api/requirements ./requirements

RUN apk add --no-cache libffi-dev
RUN apk add --no-cache --virtual .build-deps \
    "bash~=5.2" \
    "g++" \
    "gcc" \
    "cargo" \
    "git" \
    "make" \
    "postgresql-dev" \
    "libc-dev" \
    "linux-headers" \
    && \
    pip install -r requirements.txt --compile --no-cache-dir \
    && \
    apk del .build-deps \
    && \
    rm -rf /var/cache/apk/*

# Production stage
FROM python:3.12.10-alpine AS production

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV INSTANCE_CHANGELOG_URL=https://sites.plane.so/pages/691ef037bcfe416a902e48cb55f59891/

# Install runtime dependencies
RUN apk update && apk upgrade && \
    apk add --no-cache \
    "libpq" \
    "libxslt" \
    "xmlsec" \
    "ca-certificates" \
    "openssl" \
    "bash~=5.2" \
    && rm -rf /var/cache/apk/*

WORKDIR /code

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages/ /usr/local/lib/python3.12/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/

# Copy application code
COPY apps/api/manage.py manage.py
COPY apps/api/plane plane/
COPY apps/api/templates templates/
COPY apps/api/package.json package.json
COPY apps/api/bin ./bin/

# Create logs directory and set permissions
RUN mkdir -p /code/plane/logs && \
    chmod +x ./bin/* && \
    chmod -R 777 /code

# Expose port (Railway uses PORT env var)
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:${PORT:-8000}/api/v1/health-check/')" || exit 1

# Default command - API server (Railway-specific entrypoint runs migrations on startup)
CMD ["./bin/docker-entrypoint-api-railway.sh"]
